<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select mode"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/modeSelectHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Debug: logs all gestures (including activation), full vibrations, 30 s passivity timer.\n\nProduction: logs only key events, limited vibrations, no passivity timer."
        android:textSize="13sp"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/modeDebugBtn"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="Debug Mode"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/modeProdBtn"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="Production Mode"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/modeTestingBtn"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="Testing"
        android:visibility="gone"/>
</LinearLayout>
