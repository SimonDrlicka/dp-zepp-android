<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/compositeBackBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="← Back"
            android:textSize="14sp"
            style="?android:attr/borderlessButtonStyle"/>

        <TextView
            android:id="@+id/compositeScenarioTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/compositeAttemptCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="14dp"/>

        <!-- ============== RUNNING SECTION ============== -->
        <LinearLayout
            android:id="@+id/compositeRunningSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aktuálny krok"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/compositeCurrentStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/compositeMismatchBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="#D32F2F"
                android:padding="8dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Postupnosť pokusu"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/compositeStepList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aktuálny stav"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/compositeCurrentMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/compositeCurrentScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/compositeEndAttemptBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ukončiť pokus"
                android:layout_marginBottom="6dp"/>

            <Button
                android:id="@+id/compositeEndTestBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ukončiť test"
                style="?android:attr/borderlessButtonStyle"/>
        </LinearLayout>

        <!-- ============== ATTEMPT RESULT SECTION ============== -->
        <LinearLayout
            android:id="@+id/compositeResultSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/compositeResultStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:padding="10dp"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Postupnosť pokusu"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/compositeResultStepList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/compositeResultScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/compositeResultMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/compositeResultReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/compositeResultFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/compositeSaveNextBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Uložiť a pokračovať"
                android:layout_marginBottom="6dp"/>

            <Button
                android:id="@+id/compositeDiscardNextBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zahodiť a pokračovať"
                android:layout_marginBottom="6dp"/>

            <Button
                android:id="@+id/compositeResultEndTestBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ukončiť test (bez uloženia)"
                style="?android:attr/borderlessButtonStyle"/>
        </LinearLayout>

        <!-- ============== SUMMARY SECTION ============== -->
        <LinearLayout
            android:id="@+id/compositeSummarySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/compositeSummaryHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/compositeSummaryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/compositeSummaryPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/compositeSummaryDoneBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Späť na výber scenára"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
